  "extraction_config": {
    "min_keyword_length": 2,
    "max_keywords_per_text": 20,
    "min_word_frequency": 2,
    "ignore_patterns": [
      "^\\d+$",
      "^[a-zA-Z]+$",
      "^\\W+$"
    ]
