{
  "version": "1.0.0",
  "updated_at": "2025-09-13",
  "description": "关键词提取和权重计算规则配置",
  
  "tfidf_weight_rules": [
    {
      "name": "高重要性",
      "min_score": 0.3,
      "max_score": 1.0,
      "base_weight": 3.0
    },
    {
      "name": "中等重要性",
      "min_score": 0.15,
      "max_score": 0.3,
      "base_weight": 2.0
    },
    {
      "name": "低重要性",
      "min_score": 0.0,
      "max_score": 0.15,
      "base_weight": 1.0
    }
  ],
  
  "keyword_categories": [
    {
      "name": "高风险赌博类",
      "keywords": ["娱乐城", "博彩", "赌场", "赌博"],
      "weight_adjustment": 2.0,
      "max_weight": 5.0,
      "priority": 1
    },
    {
      "name": "金融交易类",
      "keywords": ["USDT", "出款", "提款", "U存U提", "泰达币", "虚拟币"],
      "weight_adjustment": 2.0,
      "max_weight": 5.0,
      "priority": 1
    },
    {
      "name": "营销推广类",
      "keywords": ["充值", "会员", "优惠", "活动", "首存", "二存", "三存", "注册送", "赠送"],
      "weight_adjustment": 1.0,
      "max_weight": 3.0,
      "priority": 2
    },
    {
      "name": "诱导词汇类",
      "keywords": ["巨额", "百亿", "千万", "豪车", "奔驰", "日赚", "月入"],
