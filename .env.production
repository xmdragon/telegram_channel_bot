# 生产环境配置文件模板
# 复制为.env并填写实际值

# =============================================================================
# Telegram配置说明
# =============================================================================
# 注意：Telegram认证通过Web界面完成，不使用环境变量
# 首次部署后访问Web管理界面进行Telegram用户认证
# 认证信息自动保存在 data/config/system.json 中

# =============================================================================
# 基础设施配置
# =============================================================================
# Redis连接URL
REDIS_URL=redis://redis:6379

# Redis密码 (生产环境推荐设置)
# REDIS_PASSWORD=your_redis_password

# 运行环境标识
ENVIRONMENT=production

# Gunicorn Worker数量 (建议CPU核数)
WORKERS=4

# =============================================================================
# 其他配置说明
# =============================================================================
# 系统配置通过JSON文件管理: data/config/system.json
# - 消息处理、过滤规则、延迟设置等
# - 日志级别、批量处理大小等
# - 目标频道、审核群等Telegram配置
# 
# 管理员配置: data/config/admins.json  
# - 默认用户名: admin
# - 默认密码: admin123
# 
# Web界面地址: https://yourdomain.com/static/login.html